# Mamed Kisisel Yapay Zeka Asistani - Ornek Ortam Degiskenleri
# Bu dosyayi api_keys.env olarak kopyalayip kendi anahtarlarinizi girin.

# Birincil LLM (Google Gemini)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Mamed Sunucu / Mobil PWA / Uzak Erisim Kimlik Dogrulama Anahtari
OPENJARVIS_API_KEY=
MAMED_API_TOKEN=

# Ucretsiz Turkce Ses (Edge-TTS) Varsayilanlari
MAMED_TTS_BACKEND=edge_tts
MAMED_TTS_VOICE=tr-TR-AhmetNeural

# Opsiyonel: ElevenLabs Ses (kota dolarsa otomatik edge_tts yedegine gecer)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Opsiyonel: Telegram Bot Entegrasyonu (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Opsiyonel: PC kapaliyken Telegram botunun kullanacagi Render sunucu adresi
MAMED_CLOUD_FALLBACK_URL=

# ntfy Bildirim Konusu
MAMED_NTFY_TOPIC=AjanMamed2706
